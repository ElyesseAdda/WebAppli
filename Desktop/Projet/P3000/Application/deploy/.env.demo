# =============================================================================
# Configuration DEMO - Environnement de démonstration P3000
# =============================================================================
# Cette configuration est pour l'environnement de test/démo destiné aux
# clients potentiels pour tester l'application avant leur propre déploiement
# =============================================================================

# -----------------------------------------------------------------------------
# IDENTIFICATION DU CLIENT
# -----------------------------------------------------------------------------
CLIENT_NAME=demo
CLIENT_DOMAIN=demo.myp3000app.com

# -----------------------------------------------------------------------------
# DJANGO - Configuration de base
# -----------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=CHANGEME_demo_secret_key_generate_with_generer_secret_key_py
ALLOWED_HOSTS=demo.myp3000app.com,www.demo.myp3000app.com

# -----------------------------------------------------------------------------
# BASE DE DONNÉES PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://p3000user:CHANGEME_DB_PASSWORD@localhost:5432/p3000db_demo

# -----------------------------------------------------------------------------
# AWS S3 - Stockage des fichiers (Drive)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=CHANGEME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGEME_AWS_SECRET_KEY
AWS_STORAGE_BUCKET_NAME=p3000-demo
AWS_S3_REGION_NAME=eu-west-3
AWS_S3_CUSTOM_DOMAIN=p3000-demo.s3.eu-west-3.amazonaws.com

# -----------------------------------------------------------------------------
# SÉCURITÉ - CORS et CSRF
# -----------------------------------------------------------------------------
CSRF_TRUSTED_ORIGINS=https://demo.myp3000app.com,https://www.demo.myp3000app.com
CORS_ALLOWED_ORIGINS=https://demo.myp3000app.com,https://www.demo.myp3000app.com

# Sécurité HTTPS
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True

# Cookies sécurisés
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# -----------------------------------------------------------------------------
# EMAIL (optionnel - pour les notifications)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGEME_demo@votreentreprise.com
EMAIL_HOST_PASSWORD=CHANGEME_EMAIL_PASSWORD

# -----------------------------------------------------------------------------
# CACHE REDIS
# -----------------------------------------------------------------------------
# DB Redis 3 (les autres clients utilisent 0, 1, 2)
REDIS_URL=redis://localhost:6379/3

# -----------------------------------------------------------------------------
# LOGS
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=/var/log/demo/django.log

# -----------------------------------------------------------------------------
# ONLYOFFICE (partagé entre tous les clients)
# -----------------------------------------------------------------------------
ONLYOFFICE_SERVER_URL=http://127.0.0.1:8080
ONLYOFFICE_JWT_SECRET=CHANGEME_SHARED_ONLYOFFICE_SECRET
